# Development & Mock Mode (Set to false in production on Vercel)
NEXT_PUBLIC_MOCK=false
NEXT_PUBLIC_BABY_SURNAME=Basio
NEXT_PUBLIC_COUPLE_NAMES="Jazzmine & Ruhmshynne Basio"

# Long random secret slug (>= 24 URL-safe chars) for /parents/[PARENTS_SLUG]
# Rotate anytime by generating a new random string and updating BOTH Vercel and Apps Script Properties
PARENTS_SLUG=replace-with-24-plus-char-random-slug

# Creator Instagram / Portfolio URL (Used for QR Code & Footer Link)
NEXT_PUBLIC_PORTFOLIO_URL=https://www.instagram.com/harramos_26

# Google Apps Script Web App URL & Shared Secret (Server-side only, never exposed to client)
APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
APPS_SCRIPT_SECRET=replace-with-strong-shared-secret
